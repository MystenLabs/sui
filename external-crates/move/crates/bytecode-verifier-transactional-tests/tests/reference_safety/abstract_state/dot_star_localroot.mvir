// w descends from o only via the alias z
//# publish
mvir 0x92::zzds_alias_descendant {

public struct S has copy, drop, store { f: u64 }
public struct O has copy, drop, store { a: Self::S, b: Self::S }

fun id_o(o: &mut Self::O): &mut Self::O {
label b0:
    return move(o);
}

fun t(o: &mut Self::O) {
    let z: &mut Self::O;
    let w: &mut Self::S;
    let n: &mut Self::O;
label b0:
    z = copy(o);
    w = &mut move(z).O::b;
    n = Self::id_o(copy(o));
    _ = move(w);
    _ = move(n);
    _ = move(o);
    return;
}

}

//# publish
mvir 0x93::zzds_alias_descendant_write {

public struct S has copy, drop, store { f: u64 }
public struct O has copy, drop, store { a: Self::S, b: Self::S }

fun id_o(o: &mut Self::O): &mut Self::O {
label b0:
    return move(o);
}

fun t(o: &mut Self::O) {
    let z: &mut Self::O;
    let n: &mut Self::O;
    let w: &mut Self::S;
label b0:
    z = copy(o);
    n = Self::id_o(copy(o));
    w = &mut move(z).O::b;
    *move(w) = S { f: 1 };
    _ = move(n);
    _ = move(o);
