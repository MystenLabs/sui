// Call transfer checks accepted by both reference safety checkers after joins and loop fixed points.

//# run
mvir 0x2::disjoint_arguments_after_join {

fun write_two(x: &mut u64, y: &mut u64) {
label b0:
    *move(x) = 1;
    *move(y) = 2;
    return;
}

entry fun t() {
    let a: u64;
    let b: u64;
    let cond: bool;
    let x: &mut u64;
    let y: &mut u64;
label b0:
    a = 0;
    b = 0;
    cond = true;
    jump_if (move(cond)) b2;
label b1:
    x = &mut a;
    y = &mut b;
    jump b3;
label b2:
    x = &mut b;
    y = &mut a;
    jump b3;
label b3:
    // The references are disjoint on both paths, even though their roots are swapped.
    Self::write_two(move(x), move(y));
    assert(copy(a) + copy(b) == 3, 60);
    return;
}

}

//# run
mvir 0x4::release_call_result_in_loop {

fun id(r: &mut u64): &mut u64 {
label b0:
    return move(r);
}

entry fun t() {
    let a: u64;
    let i: u64;
    let root: &mut u64;
    let result: &mut u64;
label b0:
    a = 0;
    i = 0;
    root = &mut a;
    result = Self::id(copy(root));
label loop_header:
    // Writing consumes the call result, releasing its dot-star extension.
    *move(result) = copy(i);
    *copy(root) = copy(i) + 10;
    jump_if (copy(i) == 2) loop_exit;
    result = Self::id(copy(root));
    i = move(i) + 1;
    jump loop_header;
label loop_exit:
    assert(*freeze(move(root)) == 12, 70);
    return;
}

}
