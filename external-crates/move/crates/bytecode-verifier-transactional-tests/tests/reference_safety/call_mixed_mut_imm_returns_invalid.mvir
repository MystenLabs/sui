// The caller treats a call's mutable results as disjoint from its immutable results. These returns
// would overlap, so the callee's return check has to reject them for that to hold.

//# publish
mvir 0x2::same_field_alias {

public struct S has copy, drop { f: u64, g: u64 }

fun split(s: &mut Self::S): &mut u64 * &u64 {
label b0:
    return &mut copy(s).S::f, &move(s).S::f;
}

}

