fun split(s: &mut Self::S): &mut u64 * &Self::Inner {
    let inner: &mut Self::Inner;
label b0:
    inner = &mut copy(s).S::inner;
    return &mut move(inner).Inner::f, &move(s).S::inner;
}

}

