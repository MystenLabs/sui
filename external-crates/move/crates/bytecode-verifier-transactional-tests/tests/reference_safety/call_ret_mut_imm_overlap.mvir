// the caller gives a mut and an imm result no edge, so the callee Ret check must reject every
// overlapping pair

//# publish
mvir 0x2::mut_and_dotstar_imm_invalid {

public struct S has copy, drop { f: u64, g: u64 }

fun id_imm(r: &Self::S): &Self::S {
label b0:
    return move(r);
}

// i covers all of s, so it may overlap m = &mut s.f
fun t(s: &mut Self::S): &mut u64 * &Self::S {
    let m: &mut u64;
    let i: &Self::S;
label b0:
    m = &mut copy(s).S::f;
    i = Self::id_imm(freeze(copy(s)));
    _ = move(s);
    return (move(m), move(i));
}

}

