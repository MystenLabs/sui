// two dot-star mut results from the same source may alias
fun t(s: &mut u64): &mut u64 * &mut u64 {
    let a: &mut u64;
    let b: &mut u64;
label b0:
    a = Self::id_mut(copy(s));
    b = Self::id_mut(copy(s));
    _ = move(s);
    return (move(a), move(b));
}

