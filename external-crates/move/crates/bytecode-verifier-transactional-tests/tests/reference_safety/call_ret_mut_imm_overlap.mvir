}

// disjoint fields: accepted
fun t(s: &mut Self::S): &mut u64 * &u64 {
    let m: &mut u64;
    let i: &u64;
label b0:
    m = &mut copy(s).S::f;
    i = Self::id_imm(&copy(s).S::g);
    _ = move(s);
    return (move(m), move(i));
}

}

