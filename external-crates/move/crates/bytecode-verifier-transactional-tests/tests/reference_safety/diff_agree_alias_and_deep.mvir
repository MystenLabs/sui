// shapes both checkers accept: sibling &mut borrows, reference returns across a join, dot-star
// in a loop, deep field chains, a local that is a reference on only one side of a join

//# run

mvir 0x46::two_mut_siblings {

public struct T has copy, drop { f: u64 }

// the old graph re-parents on factor, so the second &mut x becomes the parent of the first
entry fun t() {
    let x: Self::T;
    let s1: &mut Self::T;
    let s2: &mut Self::T;
label b0:
    x = T { f: 0 };
    s1 = &mut x;
    s2 = &mut x;
    *move(s1) = T { f: 1 };
    *move(s2) = T { f: 2 };
    return;
}

}

