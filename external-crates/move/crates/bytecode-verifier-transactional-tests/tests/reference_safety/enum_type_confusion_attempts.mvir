public enum Inner has drop { P { n: u64 }, Q { s: address } }
public enum Outer has drop { V { i: Self::Inner } }

fun id(i: &mut Self::Inner): &mut Self::Inner {
label b0:
    return move(i);
}

// mirror of 0x903: the flip goes through the original reference
entry fun t() {
    let o: Self::Outer;
    let ia: &mut Self::Inner;
    let ib: &mut Self::Inner;
