// X::One.a and X::Two.b get different labels but name the same storage. Each task builds an
// alias of the enum by a different route and tries to flip the variant through it.

//# run
mvir 0x901::alias_via_second_unpack {

public enum Inner has drop { P { n: u64 }, Q { s: address } }
public enum Outer has drop { V { i: Self::Inner } }

entry fun t() {
    let o: Self::Outer;
    let e: &mut Self::Outer;
    let ia: &mut Self::Inner;
    let ib: &mut Self::Inner;
    let n: &mut u64;
label b0:
    o = Outer::V { i: Inner::P { n: 0 } };
    e = &mut o;
    &mut Outer::V { i: ia } = copy(e);
    &mut Outer::V { i: ib } = copy(e);
    &mut Inner::P { n: n } = move(ia);
    *move(ib) = Inner::Q { s: 0x0 };
    *move(n) = 1;
    _ = move(e);
    return;
}

}

//# run
mvir 0x902::alias_via_copy {

public enum Inner has drop { P { n: u64 }, Q { s: address } }
public enum Outer has drop { V { i: Self::Inner } }

entry fun t() {
    let o: Self::Outer;
    let ia: &mut Self::Inner;
    let ic: &mut Self::Inner;
    let n: &mut u64;
label b0:
    o = Outer::V { i: Inner::P { n: 0 } };
    &mut Outer::V { i: ia } = &mut o;
    ic = copy(ia);
    &mut Inner::P { n: n } = move(ia);
    *move(ic) = Inner::Q { s: 0x0 };
    *move(n) = 1;
    return;
}

}

