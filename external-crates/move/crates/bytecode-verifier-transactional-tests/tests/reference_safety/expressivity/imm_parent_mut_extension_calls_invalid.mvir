// Regex reference safety permits constructing an immutable parent with a mutable extension, then
// rejects only the call or write that could invalidate the relationship.

//# publish
mvir 0x4::transfer_related_refs {

public struct Inner has copy, drop { value: u64 }
public struct Outer has copy, drop { field: Self::Inner }

fun consume(inner: &mut Self::Inner, outer: &Self::Outer) {
label b0:
    _ = move(inner);
    _ = move(outer);
    return;
}

fun t() {
    let a: Self::Outer;
    let x: &mut Self::Inner;
    let y: &Self::Outer;
label b0:
    a = Outer { field: Inner { value: 0 } };
    x = &mut (&mut a).Outer::field;
    // The old checker rejects here, before reaching the unsafe transfer.
    y = &a;
    // The regex checker rejects transferring the related parent and extension together.
    Self::consume(copy(x), copy(y));
    return;
}

}

//# publish
mvir 0x5::returned_extension_blocks_write {

public struct Inner has copy, drop { value: u64 }
public struct Outer has copy, drop { field: Self::Inner }

fun borrow_value(inner: &mut Self::Inner): &mut u64 {
label b0:
    return &mut move(inner).Inner::value;
