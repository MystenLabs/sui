label b0:
    a = Outer { field: Inner { value: 0 } };
    x = &mut (&mut a).Outer::field;
    // The old checker rejects here, before the call and write are analyzed.
    y = &a;
    // The returned reference is a possible non-epsilon extension of x.
    result = Self::borrow_value(copy(x));
    // The returned extension itself is writable and remains live through this copied alias.
    *copy(result) = 1;
    // Replacing x could now dangle result, so the regex checker must reject this write.
    *copy(x) = Inner { value: 1 };
    _ = move(result);
    _ = move(y);
    return;
