// Calls can transfer either side of an immutable-parent/mutable-extension relationship when the
// related reference remains in the caller.

//# publish
mvir 0x2::transfer_mut_extension {

public struct Inner has copy, drop { value: u64 }
public struct Outer has copy, drop { field: Self::Inner }

fun mutate(inner: &mut Self::Inner) {
label b0:
    *move(inner) = Inner { value: 1 };
    return;
}

fun t() {
    let a: Self::Outer;
    let x: &mut Self::Inner;
    let y: &Self::Outer;
label b0:
    a = Outer { field: Inner { value: 0 } };
    x = &mut (&mut a).Outer::field;
    // The old checker rejects this immutable parent while x is live.
    y = &a;
    // Transferring only the mutable extension cannot cause a dangling reference
    Self::mutate(copy(x));
    *move(x) = Inner { value: 2 };
    _ = *move(y);
    return;
}

}

