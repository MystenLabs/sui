// copy_loc on a reference local makes an epsilon alias; releasing the original must keep its
// local_root edge

//# run
mvir 0x42::m {
    public struct S has drop { f: u64 }

    entry fun t() {
        let x: Self::S;
        let r: &mut Self::S;
        let r2: &mut Self::S;
        let v: u64;
    label b0:
        x = S { f: 1 };
        r = &mut x;
        r2 = copy(r);
        _ = move(r);
        x = S { f: 5 };
        v = *(&copy(r2).S::f);
        _ = move(r2);
        assert(move(v) == 5, 400);
        return;
    }
}
