// StLoc over a struct local that has a live epsilon alias

//# run
mvir 0x42::m {
    public struct S has drop { f: u64 }

    entry fun t() {
        let x: Self::S;
        let r: &mut Self::S;
        let fr: &mut u64;
        let v: u64;
    label b0:
        x = S { f: 1 };
        r = &mut x;
        x = S { f: 7 };
        // field borrow through the stale reference
        fr = &mut move(r).S::f;
        *move(fr) = 99;
        v = *(&mut (&mut x).S::f);
        assert(move(v) == 99, 101);
        return;
    }
}
