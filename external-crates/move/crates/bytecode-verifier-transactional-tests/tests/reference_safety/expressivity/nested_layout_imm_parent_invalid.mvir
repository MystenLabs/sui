    let items_imm: &vector<u64>;
    let elem_imm: &u64;
label b0:
    &mut E::V { items: items_mut } = copy(e);
    items_alias = copy(items_mut);
    // The old checker rejects here, before reaching the unsafe vector update.
    e_imm = freeze(copy(e));
    &E::V { items: items_imm } = move(e_imm);
    elem_imm = vec_imm_borrow<u64>(move(items_imm), 0);
    // Reallocation through the alias could dangle elem_imm.
    vec_push_back<u64>(copy(items_alias), 1);
    _ = *move(elem_imm);
    _ = move(items_alias);
    _ = move(items_mut);
    return;
}

}

