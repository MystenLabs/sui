// Mutable extensions of immutable parents remain usable across nested enum and vector layouts
// when the update cannot dangle a deeper reference.

//# publish
mvir 0x2::enum_contains_vector {

public enum E has drop {
    V { items: vector<u64> },
}

fun t(e: &mut Self::E) {
    let items_mut: &mut vector<u64>;
    let items_alias: &mut vector<u64>;
    let e_imm: &Self::E;
    let items_imm: &vector<u64>;
label b0:
    &mut E::V { items: items_mut } = copy(e);
    items_alias = copy(items_mut);
    // The old checker rejects constructing this immutable parent.
    e_imm = freeze(copy(e));
    &E::V { items: items_imm } = move(e_imm);
    // Both item refs point to the vector; changing it cannot dangle either one.
    vec_push_back<u64>(copy(items_alias), 1);
    _ = vec_len<u64>(move(items_imm));
    _ = move(items_alias);
    _ = move(items_mut);
    return;
}

}

//# publish
mvir 0x3::vector_contains_enum {

public enum E has drop {
    A { value: u64 },
    B { value: u64 },
}

fun t(v: &mut vector<Self::E>) {
    let elem_mut: &mut Self::E;
    let elem_alias: &mut Self::E;
    let v_imm: &vector<Self::E>;
label b0:
    elem_mut = vec_mut_borrow<Self::E>(copy(v), 0);
    elem_alias = copy(elem_mut);
    // The old checker rejects constructing this immutable parent.
    v_imm = freeze(copy(v));
    // Replacing an element's variant cannot dangle a reference to the vector itself
    *copy(elem_alias) = E::B { value: 1 };
    _ = vec_len<Self::E>(move(v_imm));
    _ = move(elem_alias);
    _ = move(elem_mut);
    return;
}

}

//# publish
mvir 0x4::nested_vectors {

fun t(outer: &mut vector<vector<u64>>) {
    let inner_mut: &mut vector<u64>;
    let inner_alias: &mut vector<u64>;
    let outer_imm: &vector<vector<u64>>;
label b0:
    inner_mut = vec_mut_borrow<vector<u64>>(copy(outer), 0);
    inner_alias = copy(inner_mut);
    // The old checker rejects constructing this immutable parent.
    outer_imm = freeze(copy(outer));
    // Updating the inner vector cannot dangle the outer vector
    vec_push_back<u64>(copy(inner_alias), 1);
    _ = vec_len<vector<u64>>(move(outer_imm));
    _ = move(inner_alias);
    _ = move(inner_mut);
    return;
}

}

//# publish
mvir 0x5::returned_inner_vector {

fun first(outer: &mut vector<vector<u64>>): &mut vector<u64> {
label b0:
    return vec_mut_borrow<vector<u64>>(move(outer), 0);
}

fun t(outer: &mut vector<vector<u64>>) {
    let inner_mut: &mut vector<u64>;
    let inner_alias: &mut vector<u64>;
    let outer_imm: &vector<vector<u64>>;
label b0:
    inner_mut = Self::first(copy(outer));
    inner_alias = copy(inner_mut);
    // The old checker rejects constructing this immutable parent.
    outer_imm = freeze(copy(outer));
    // Updating the returned inner vector cannot dangle the outer vector
    vec_push_back<u64>(copy(inner_alias), 1);
    _ = vec_len<vector<u64>>(move(outer_imm));
    _ = move(inner_alias);
    _ = move(inner_mut);
    return;
}

}

//# publish
mvir 0x6::swap_nonflat_with_imm_alias {

public enum E has drop {
    A { value: u64 },
    B { value: u64 },
}

fun t(v: &mut vector<Self::E>) {
    let v_alias: &mut vector<Self::E>;
    let v_imm: &vector<Self::E>;
label b0:
    v_alias = copy(v);
    // The old checker rejects this immutable alias while v_alias is live.
    v_imm = freeze(copy(v));
    // With no element extension, swapping through the mutable alias cannot dangle a reference.
    vec_swap<Self::E>(copy(v_alias), 0, 1);
    _ = vec_len<Self::E>(move(v_imm));
    _ = move(v_alias);
    return;
}

}
