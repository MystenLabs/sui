// the caller assumes mut results are pairwise disjoint and live inside a mut argument; try to
// build a callee that violates each

//# publish
mvir 0x2::callee_returns_aliasing_mut_pair {

public struct S has copy, drop { f: u64 }

// two mutable results that are epsilon aliases
fun bad(p: &mut Self::S): &mut Self::S * &mut Self::S {
label b0:
    return copy(p), move(p);
}

}

//# publish
mvir 0x3::callee_returns_mut_and_its_extension {

public struct S has copy, drop { f: u64 }

fun bad(p: &mut Self::S): &mut Self::S * &mut u64 {
label b0:
    return copy(p), &mut move(p).S::f;
}

}

//# publish
mvir 0x4::callee_returns_imm_parent_mut_child {

public struct S has copy, drop { f: u64 }

fun bad(p: &mut Self::S): &Self::S * &mut u64 {
label b0:
    return freeze(copy(p)), &mut move(p).S::f;
}

}

