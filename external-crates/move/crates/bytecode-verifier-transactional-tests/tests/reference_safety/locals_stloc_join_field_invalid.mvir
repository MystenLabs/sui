// one branch makes r a field borrow of x, so StLoc x must be rejected

//# publish
mvir 0x42::m {
    public struct S has drop { f: u64 }

    fun t() {
        let x: Self::S;
        let y: u64;
        let r: &mut u64;
    label b0:
        x = S { f: 1 };
        y = 2;
        jump_if (true) b2;
    label b1:
        r = &mut (&mut x).S::f;
        jump b3;
    label b2:
        r = &mut y;
    label b3:
        x = S { f: 3 };
        *move(r) = 9;
        return;
    }
}
