// dot-star element refs composed with field and variant-field labels, and nested vectors

//# run
mvir 0x21::elem_field_then_push {

public struct S has drop, copy { f: u64 }

entry fun t() {
    let v: vector<Self::S>;
    let vr: &mut vector<Self::S>;
    let e: &mut Self::S;
    let ef: &mut u64;
label b0:
    v = vector<Self::S; 1>(S { f: 1 });
    vr = &mut v;
    e = vec_mut_borrow<Self::S>(copy(vr), 0);
    ef = &mut (move(e)).S::f;
    vec_push_back<Self::S>(copy(vr), S { f: 2 });
    *move(ef) = 99;
    _ = move(vr);
    return;
}

}

//# run
mvir 0x22::elem_variant_field_then_pop {

public enum E has drop { A { x: u64 } }

entry fun t() {
    let v: vector<Self::E>;
    let vr: &mut vector<Self::E>;
    let e: &mut Self::E;
    let x: &mut u64;
label b0:
    v = vector<Self::E; 1>(E::A { x: 1 });
    vr = &mut v;
    e = vec_mut_borrow<Self::E>(copy(vr), 0);
    &mut E::A { x: x } = move(e);
    _ = vec_pop_back<Self::E>(copy(vr));
    *move(x) = 99;
    _ = move(vr);
    return;
}

}

//# run
mvir 0x23::struct_field_vector_overwrite {

public struct S has drop { v: vector<u64> }

entry fun t() {
    let s: Self::S;
    let sr: &mut Self::S;
    let vr: &mut vector<u64>;
    let e: &mut u64;
label b0:
    s = S { v: vector<u64; 1>(1) };
    sr = &mut s;
    vr = &mut (copy(sr)).S::v;
    e = vec_mut_borrow<u64>(copy(vr), 0);
    *move(sr) = S { v: vector<u64; 0>() };
    *move(e) = 5;
    _ = move(vr);
    return;
}

}

//# run
mvir 0x24::inner_elem_push_outer {

entry fun t() {
    let vv: vector<vector<u64>>;
    let o: &mut vector<vector<u64>>;
    let i: &mut vector<u64>;
    let e: &mut u64;
label b0:
    vv = vector<vector<u64>; 1>(vector<u64; 1>(7));
    o = &mut vv;
    i = vec_mut_borrow<vector<u64>>(copy(o), 0);
    e = vec_mut_borrow<u64>(move(i), 0);
    vec_push_back<vector<u64>>(copy(o), vector<u64; 0>());
    *move(e) = 5;
    _ = move(o);
    return;
}

}

//# run
mvir 0x25::inner_ref_pop_outer {

entry fun t() {
    let vv: vector<vector<u64>>;
    let o: &mut vector<vector<u64>>;
    let i: &mut vector<u64>;
label b0:
    vv = vector<vector<u64>; 1>(vector<u64; 1>(7));
    o = &mut vv;
    i = vec_mut_borrow<vector<u64>>(copy(o), 0);
    _ = vec_pop_back<vector<u64>>(copy(o));
    vec_push_back<u64>(move(i), 3);
    _ = move(o);
    return;
}

}

//# run
mvir 0x26::inner_ref_swap_outer {

entry fun t() {
    let vv: vector<vector<u64>>;
    let o: &mut vector<vector<u64>>;
    let i: &mut vector<u64>;
label b0:
    vv = vector<vector<u64>; 2>(vector<u64; 1>(7), vector<u64; 1>(8));
    o = &mut vv;
    i = vec_mut_borrow<vector<u64>>(copy(o), 0);
    vec_swap<vector<u64>>(copy(o), 0, 1);
    vec_push_back<u64>(move(i), 3);
    _ = move(o);
    return;
}

}

//# run
mvir 0x27::inner_push_is_fine {

entry fun t() {
    let vv: vector<vector<u64>>;
    let o: &mut vector<vector<u64>>;
    let i: &mut vector<u64>;
label b0:
    vv = vector<vector<u64>; 1>(vector<u64; 1>(7));
    o = &mut vv;
    i = vec_mut_borrow<vector<u64>>(copy(o), 0);
    vec_push_back<u64>(copy(i), 3);
    assert(vec_len<u64>(freeze(move(i))) == 2, 42);
    assert(vec_len<vector<u64>>(freeze(move(o))) == 1, 43);
    return;
}

}
