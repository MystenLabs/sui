module pattern_mut {
    public fun add_one () {
        *l0 = *l0 + 1u64
    }

    public fun borrow_arm_binding () {
        let l3 = l0;
        return match(&l3: E) {
            E::A { x: reg_4 } => {
                let E::A { x: reg_6 } = l3;
                let l4 = reg_6;
                pattern_mut::add_one(&mut l4)
                l4
            },
            E::B => {
                let E::B {} = l3;
                0u64
            },
        }
    }

    public fun rebind_arm_binding () {
        let l4 = l0;
        return match(&l4: E) {
            E::A { x: reg_4 } => {
                let E::A { x: reg_6 } = l4;
                reg_6 + l1
            },
            E::B => {
                let E::B {} = l4;
                0u64
            },
        }
    }

    public fun rebind_param () {
        return l0 + 1u64
    }

    public fun rebind_unpack_binding () {
        let S { v: reg_1 } = l0;
        return reg_1 + 1u64
    }

}
