module needs_mut {
    public fun add_one () {
        *l0 = *l0 + 1u64
    }

    public fun arm_binding () {
        let l3 = l0;
        return match(&l3: E) {
            E::A { x: reg_4 } => {
                let E::A { x: reg_6 } = l3;
                let l4 = reg_6;
                needs_mut::add_one(&mut l4)
                l4
            },
            E::B => {
                let E::B {} = l3;
                0u64
            },
        }
    }

    public fun assign_reaching_back_edge () {
        let l1 = 0u64;
        while(l1 < l0) {
            l1 = l1 + 1u64;
        }
        return l1
    }

    public fun assign_then_break () {
        let l3 = 0u64;
        while(l3 < l0) {
            l3 = l3 + 1u64;
        }
        let l4 = l3;
        return if (l4 > l1) {
            l4 - l1
        } else {
            l1 - l4
        }
    }

    public fun declare_double_assign () {
        let l1, l2;
        l2 = if (l0) {
            l1 = 1u64;
            2u64
        } else {
            l1 = 3u64;
            4u64
        };
        if (l0) {
            l1 = 5u64;
        }
        return l1 + l2
    }

    public fun declare_single_assign_per_path () {
        let l1, l2;
        l2 = if (l0) {
            l1 = 1u64;
            2u64
        } else {
            l1 = 3u64;
            4u64
        };
        return l1 + l2
    }

    public fun double () {
        return l0 + l0
    }

    public fun labeled_break_exits_both_loops () {
        let l3 = 0u64;
        loop {
            let l4 = 0u64;
            loop {
                if (l3 + l4 >= l0) {
                    let l5 = l3 + l4;
                    return if (l5 > l1) {
                        l5 - l1
                    } else {
                        l1 - l5
                    }
                }
                if (l4 >= l1) {
                    l3 = l3 + 1u64;
                    break;
                }
                l4 = l4 + 1u64;
            }
        }
    }

    public fun mut_borrowed_let () {
        let l1 = l0;
        needs_mut::add_one(&mut l1)
        return l1
    }

    public fun param_mut_borrow () {
        needs_mut::add_one(&mut l0)
        return l0
    }

    public fun reassigned_let () {
        let l2 = l1;
        if (l0) {
            l2 = l1 + 1u64;
        }
        return l2 + l2
    }

    public fun unassigned_let () {
        let l1 = needs_mut::double(l0);
        return l1 + l1
    }

    public fun unpack_binding () {
        let S { v: reg_1, w: reg_2 } = l0;
        let l1 = reg_1;
        needs_mut::add_one(&mut l1)
        return l1 + reg_2
    }

}
