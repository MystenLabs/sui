module needs_mut_labeled_break {
    public fun labeled_break_exits_both_loops () {
        let l3 = 0u64;
        loop {
            let l4 = 0u64;
            loop {
                if (l3 + l4 >= l0) {
                    let l5 = l3 + l4;
                    return if (l5 > l1) {
                        l5 - l1
                    } else {
                        l1 - l5
                    }
                }
                if (l4 >= l1) {
                    l3 = l3 + 1u64;
                    break;
                }
                l4 = l4 + 1u64;
            }
        }
    }

}
